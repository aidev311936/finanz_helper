# LLM Provider: openai | gemini | anthropic
LLM_PROVIDER=openai

# API Keys (nur der zum gewählten Provider passende wird benötigt)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: Model override (sonst wird der Standard des Providers verwendet)
# LLM_MODEL=gpt-4o-mini

# Optional: Limits pro User/Tag
# LLM_DAILY_REQUEST_LIMIT=50
# LLM_DAILY_TOKEN_LIMIT=100000

# URL der Sparbot-Web-App (wird vom Anonymizer-Frontend als Link verwendet)
VITE_SPARBOT_URL=http://localhost:5174
